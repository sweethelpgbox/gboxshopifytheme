    "rich_text_HTUeD8": {
      "type": "rich-text",
      "blocks": {
        "heading_WVPVNi": {
          "type": "heading",
          "settings": {
            "heading": "<em><strong>G-BOX Freeze Dried Candy: </strong></em>                      Where sweets meet science",
            "heading_size": "h2"
          }
        },
        "text_BD9HyN": {
          "type": "text",
          "settings": {
            "text": "<p>G-BOX Freeze Dried Candy brings a delightful twist to your favorite sweets by transforming them into light, crunchy, and irresistibly flavorful treats. Using advanced freeze-drying technology, GBOX removes moisture while locking in the original taste and color, resulting in a unique texture that melts in your mouth. From classic fruity candies to chewy taffies and marshmallows, GBOX offers a fun, airy crunch that candy lovers of all ages can enjoy. Unlike traditional candy, these treats have a longer shelf life and are perfect for snacking on the go, adding to gift baskets, or sharing at parties. Whether you're looking to explore new candy textures or searching for a low-mess alternative to sticky sweets, GBOX Freeze Dried Candy is a game-changer in the world of confections. Indulge in the sweet, crisp experience that’s quickly becoming a favorite among adventurous snackers and sweet tooths alike.</p>"
          }
        }
      },
