{% layout 'password' %}

<div class="password-page">

  <header class="password-header">
    <a href="/" class="nav-logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 240 | image_tag: loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span class="password-shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </header>

  <main class="password-main">
    <div class="password-inner">
      <span class="badge" style="margin-bottom:20px">Coming Soon</span>
      <h1 class="password-heading">{{ shop.name }} is getting ready.</h1>
      <p class="password-subheading">We're crafting something crunchy and delicious. Enter the password to get early access, or sign up to be notified when we launch.</p>

      <!-- Email signup -->
      {%- form 'customer', class: 'password-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        {%- if form.posted_successfully? -%}
          <p class="password-success">You're on the list! We'll notify you at launch. 🎉</p>
        {%- else -%}
          <div class="search-input-wrap" style="max-width:420px;margin-inline:auto">
            <input class="search-input" type="email" name="contact[email]" placeholder="Your email address..." required aria-label="Email address">
            <button type="submit" class="btn btn-primary">Notify Me</button>
          </div>
          {%- if form.errors -%}
            <p class="password-error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <!-- Password form -->
      <div class="password-divider"><span>Already have the password?</span></div>
      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}
          <p class="password-error">Incorrect password. Please try again.</p>
        {%- endif -%}
        <div class="search-input-wrap" style="max-width:360px;margin-inline:auto">
          <input class="search-input" type="password" name="password" placeholder="Enter store password" required aria-label="Store password">
          <button type="submit" class="btn btn-outline">Enter</button>
        </div>
      {%- endform -%}
    </div>
  </main>

</div>
