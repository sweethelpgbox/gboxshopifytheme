<div class="section customer-page">
  <div class="container">
    <div class="customer-form-wrap">

      <h1 class="page-title">Log in</h1>

      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="form-errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-field">
          <label class="form-label" for="CustomerEmail">Email</label>
          <input class="form-input" type="email" id="CustomerEmail" name="customer[email]"
            autocomplete="email" autocorrect="off" autocapitalize="off"
            value="{{ form.email }}" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="CustomerPassword">
            Password
            <a href="/account/recover" class="form-label-link">Forgot password?</a>
          </label>
          <input class="form-input" type="password" id="CustomerPassword" name="customer[password]"
            autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Log in</button>
      {%- endform -%}

      <p class="customer-form-alt">
        New customer? <a href="/account/register">Create account</a>
      </p>

    </div>
  </div>
</div>
