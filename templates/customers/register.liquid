<div class="section customer-page">
  <div class="container">
    <div class="customer-form-wrap">

      <h1 class="page-title">Create account</h1>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="form-errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="FirstName">First name</label>
            <input class="form-input" type="text" id="FirstName" name="customer[first_name]"
              autocomplete="given-name" value="{{ form.first_name }}">
          </div>
          <div class="form-field">
            <label class="form-label" for="LastName">Last name</label>
            <input class="form-input" type="text" id="LastName" name="customer[last_name]"
              autocomplete="family-name" value="{{ form.last_name }}">
          </div>
        </div>

        <div class="form-field">
          <label class="form-label" for="Email">Email</label>
          <input class="form-input" type="email" id="Email" name="customer[email]"
            autocomplete="email" autocorrect="off" autocapitalize="off"
            value="{{ form.email }}" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="CreatePassword">Password</label>
          <input class="form-input" type="password" id="CreatePassword" name="customer[password]"
            autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Create account</button>
      {%- endform -%}

      <p class="customer-form-alt">
        Already have an account? <a href="/account/login">Log in</a>
      </p>

    </div>
  </div>
</div>
