<div class="section customer-page">
  <div class="container">
    <div class="customer-form-wrap">

      <h1 class="page-title">Activate account</h1>
      <p style="color:var(--color-text-muted);margin-bottom:28px">Create a password to activate your account.</p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="form-field">
          <label class="form-label" for="Password">Password</label>
          <input class="form-input" type="password" id="Password" name="customer[password]"
            autocomplete="new-password" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="PasswordConfirmation">Confirm password</label>
          <input class="form-input" type="password" id="PasswordConfirmation"
            name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Activate account</button>
      {%- endform -%}

    </div>
  </div>
</div>
