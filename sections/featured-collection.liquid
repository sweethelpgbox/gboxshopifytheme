{%- liquid
  assign collection = collections[section.settings.collection]
  assign products   = collection.products | default: empty
  assign limit      = section.settings.products_to_show | default: 4
-%}

<section class="section features-section" id="featured-collection-{{ section.id }}">
  <div class="container">

    <header class="section-header">
      <div>
        {%- if section.settings.badge != blank -%}
          <span class="badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank and collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn-outline">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </header>

    <div class="product-grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- assign has_compare = product.compare_at_price > product.price -%}
          {%- if has_compare -%}
            {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          {%- endif -%}

          <article class="product-card" data-variant-id="{{ product.first_available_variant.id }}">
            <a href="{{ product.url }}" class="product-card-media">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: product.featured_media.alt | escape
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if product.available == false -%}
                <span class="product-card-badge" style="background:var(--color-text-muted)">Sold Out</span>
              {%- elsif has_compare -%}
                <span class="product-card-badge">-{{ savings }}%</span>
              {%- elsif product.tags contains 'new' -%}
                <span class="product-card-badge" style="background:var(--color-accent-2)">New</span>
              {%- endif -%}

              <button class="product-card-quick-add" aria-label="Quick add {{ product.title | escape }}">Quick Add</button>
            </a>

            <div class="product-card-body">
              {%- if product.vendor != blank -%}
                <p class="product-card-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="product-card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="product-card-price">
                <span class="price-current">{{ product.price | money }}</span>
                {%- if has_compare -%}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ savings }}%</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="product-card">
            <div class="product-card-media">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card-body">
              <p class="product-card-vendor">Brand Name</p>
              <h3 class="product-card-title">Sample Product {{ forloop.index }}</h3>
              <div class="product-card-price">
                <span class="price-current">$49.00</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": "🔥 Trending"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Drop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "As seen on TikTok — grab yours before it sells out."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all products"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
