<section class="section main-404" id="main-404-{{ section.id }}">
  <div class="container">
    <div class="error-404">
      <div class="error-404-graphic">{{ section.settings.emoji }}</div>
      <h1 class="error-404-title">{{ section.settings.heading }}</h1>
      <p class="error-404-body">{{ section.settings.subheading }}</p>
      <div class="error-404-actions">
        <a href="/" class="btn btn-primary">Go back home</a>
        <a href="/collections/all" class="btn btn-outline">Browse products</a>
      </div>
      {%- if section.settings.show_search -%}
        <form action="/search" method="get" class="error-404-search" role="search">
          <input type="hidden" name="type" value="product">
          <div class="search-input-wrap" style="max-width:480px;margin-inline:auto">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="search-input" type="search" name="q" placeholder="Search products..." aria-label="Search">
            <button type="submit" class="btn btn-primary">Search</button>
          </div>
        </form>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "emoji",
      "label": "Emoji or icon character",
      "default": "🍬"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Oops — looks like this page got freeze-dried and disappeared. Let's get you back on track."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "404"
    }
  ]
}
{% endschema %}
