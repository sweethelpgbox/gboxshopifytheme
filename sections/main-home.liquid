<div style="padding: 80px 40px; text-align: center; font-family: sans-serif;">
  <h1>{{ section.settings.heading }}</h1>
  <p style="color: #666; margin-top: 16px;">{{ section.settings.subheading }}</p>
</div>

{% schema %}
{
  "name": "Home",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We're just getting started."
    }
  ],
  "presets": [
    {
      "name": "Home"
    }
  ]
}
{% endschema %}
