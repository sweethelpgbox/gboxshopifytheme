<section class="section main-cart" id="main-cart-{{ section.id }}">
  <div class="container">

    <h1 class="page-title">Your Cart</h1>

    {%- if cart.item_count > 0 -%}
      <form action="/cart" method="post" class="cart-layout">

        <!-- Line items -->
        <div class="cart-items">
          <div class="cart-items-header">
            <span>Product</span>
            <span>Quantity</span>
            <span>Total</span>
          </div>

          {%- for item in cart.items -%}
            <div class="cart-item" data-key="{{ item.key }}">

              <!-- Image -->
              <a href="{{ item.url }}" class="cart-item-media">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', alt: item.image.alt | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>

              <!-- Info -->
              <div class="cart-item-info">
                <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item-price">{{ item.price | money }}</p>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0"
                   class="cart-item-remove"
                   aria-label="Remove {{ item.product.title | escape }}">Remove</a>
              </div>

              <!-- Quantity -->
              <div class="quantity-selector">
                <button type="button" class="qty-btn" data-action="decrease" data-key="{{ item.key }}" aria-label="Decrease">−</button>
                <input class="qty-input" type="number" name="updates[]" value="{{ item.quantity }}"
                  min="0" data-key="{{ item.key }}" aria-label="Quantity for {{ item.product.title | escape }}">
                <button type="button" class="qty-btn" data-action="increase" data-key="{{ item.key }}" aria-label="Increase">+</button>
              </div>

              <!-- Line total -->
              <div class="cart-item-total">{{ item.line_price | money }}</div>

            </div>
          {%- endfor -%}
        </div>

        <!-- Summary -->
        <div class="cart-summary">
          <div class="cart-summary-inner">
            <h2 class="cart-summary-title">Order Summary</h2>

            <div class="cart-summary-row">
              <span>Subtotal ({{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %})</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            {%- if section.settings.show_shipping_note -%}
              <p class="cart-shipping-note">{{ section.settings.shipping_note }}</p>
            {%- endif -%}

            {%- if section.settings.show_note -%}
              <div class="cart-note-field">
                <label for="CartNote">Order note</label>
                <textarea id="CartNote" name="note" rows="3" placeholder="Any special instructions?">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <button type="submit" name="checkout" class="btn btn-primary btn-full">
              Proceed to Checkout — {{ cart.total_price | money }}
            </button>

            <a href="/collections/all" class="btn btn-outline btn-full" style="margin-top:8px">
              Continue Shopping
            </a>
          </div>
        </div>

      </form>

    {%- else -%}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="/collections/all" class="btn btn-primary">Start Shopping</a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  document.querySelectorAll('.qty-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key   = this.dataset.key;
      var input = document.querySelector('.qty-input[data-key="' + key + '"]');
      if (!input) return;
      var val = parseInt(input.value) || 0;
      if (this.dataset.action === 'increase') input.value = val + 1;
      else if (val > 0) input.value = val - 1;
    });
  });
</script>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shipping_note",
      "label": "Show shipping note",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note text",
      "default": "Shipping & taxes calculated at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show order note field",
      "default": false
    }
  ]
}
{% endschema %}
