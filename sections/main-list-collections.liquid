{%- paginate collections.all by section.settings.collections_per_page -%}
<section class="section main-list-collections" id="main-list-collections-{{ section.id }}">
  <div class="container">

    <header class="page-header">
      <h1 class="page-title">{{ section.settings.heading | default: 'All Collections' }}</h1>
    </header>

    <div class="collections-grid">
      {%- for collection in collections.all -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card-media">
            {%- if collection.image -%}
              {{
                collection.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', alt: collection.title | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="collection-card-overlay">
              <h2 class="collection-card-title">{{ collection.title }}</h2>
              {%- if collection.products_count > 0 -%}
                <p class="collection-card-count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
              {%- endif -%}
              <span class="collection-card-cta">Shop now →</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Collections pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn-outline">← Previous</a>
        {%- endif -%}
        <span class="pagination-count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn-outline">Next →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Collections per page",
      "default": 12
    }
  ]
}
{% endschema %}
