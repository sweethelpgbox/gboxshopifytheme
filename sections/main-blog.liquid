<section class="section main-blog" id="main-blog-{{ section.id }}">
  <div class="container">

    <header class="page-header">
      <h1 class="page-title">{{ blog.title }}</h1>
      {%- if blog.articles_count > 0 -%}
        <p class="page-subtitle">{{ blog.articles_count }} article{% if blog.articles_count != 1 %}s{% endif %}</p>
      {%- endif -%}
    </header>

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <div class="blog-tags">
        <a href="{{ blog.url }}" class="blog-tag {% unless current_tags %}active{% endunless %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}"
             class="blog-tag {% if current_tags contains tag %}active{% endif %}">
            {{ tag }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="blog-grid">
      {%- for article in blog.articles limit: section.settings.articles_per_page -%}
        <article class="article-card">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="article-card-media">
              {{
                article.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', alt: article.image.alt | escape
              }}
            </a>
          {%- endif -%}
          <div class="article-card-body">
            {%- if section.settings.show_tags and article.tags.size > 0 -%}
              <div class="article-tags">
                {%- for tag in article.tags limit: 2 -%}
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <h2 class="article-card-title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>
            {%- if section.settings.show_excerpt and article.excerpt != blank -%}
              <p class="article-card-excerpt">{{ article.excerpt | strip_html | truncate: 160 }}</p>
            {%- endif -%}
            <div class="article-card-meta">
              {%- if section.settings.show_author -%}
                <span>{{ article.author }}</span>
              {%- endif -%}
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%B %d, %Y' }}
              </time>
            </div>
            <a href="{{ article.url }}" class="article-card-read-more">Read more →</a>
          </div>
        </article>
      {%- else -%}
        <p class="blog-empty">No articles published yet. Check back soon!</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Blog pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn-outline">← Previous</a>
        {%- endif -%}
        <span class="pagination-count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn-outline">Next →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    }
  ]
}
{% endschema %}
