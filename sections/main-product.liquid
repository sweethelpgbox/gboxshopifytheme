{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_compare = current_variant.compare_at_price > current_variant.price -%}
{%- if has_compare -%}
  {%- assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
{%- endif -%}

<section class="section main-product" id="main-product-{{ section.id }}">
  <div class="container">
    <div class="product-layout">

      <!-- Media gallery -->
      <div class="product-media-gallery">
        {%- if product.media.size > 0 -%}
          <div class="product-media-main">
            {{
              product.featured_media
              | image_url: width: 900
              | image_tag: loading: 'eager', id: 'ProductFeaturedImage', alt: product.featured_media.alt | escape
            }}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="product-media-thumbs">
              {%- for media in product.media -%}
                <button class="product-thumb{% if forloop.first %} active{% endif %}"
                  data-src="{{ media | image_url: width: 900 }}"
                  aria-label="View image {{ forloop.index }}">
                  {{
                    media
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', alt: media.alt | escape
                  }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="product-media-main">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Product info -->
      <div class="product-info">

        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-title">{{ product.title }}</h1>

        <div class="product-price-row">
          <span class="price-current" id="ProductPrice">{{ current_variant.price | money }}</span>
          {%- if has_compare -%}
            <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="badge">Save {{ savings }}%</span>
          {%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="product-variants">
            {%- for option in product.options_with_values -%}
              <div class="variant-group">
                <label class="variant-label">{{ option.name }}</label>
                <div class="variant-options">
                  {%- for value in option.values -%}
                    <button class="variant-btn{% if option.selected_value == value %} selected{% endif %}"
                      data-option-position="{{ option.position }}"
                      data-value="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <form action="/cart/add" method="post" id="ProductForm" novalidate>
          <input type="hidden" name="id" id="ProductVariantId" value="{{ current_variant.id }}">

          <div class="product-quantity-row">
            <label class="variant-label" for="ProductQuantity">Quantity</label>
            <div class="quantity-selector">
              <button type="button" class="qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
              <input id="ProductQuantity" class="qty-input" type="number" name="quantity" value="1" min="1">
              <button type="button" class="qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="product-actions">
            {%- if current_variant.available -%}
              <button type="submit" class="btn btn-primary btn-full" id="AddToCart">
                Add to Cart — {{ current_variant.price | money }}
              </button>
            {%- else -%}
              <button type="submit" class="btn btn-primary btn-full" disabled>Sold Out</button>
            {%- endif -%}
          </div>
        </form>

        {%- if section.settings.show_description and product.description != blank -%}
          <div class="product-description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          <div class="product-share">
            <span>Share:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener">Facebook</a>
            <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener">Twitter</a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var productData = {{ product.variants | json }};
    var variantMap = {};
    productData.forEach(function(v) { variantMap[v.id] = v; });

    document.querySelectorAll('.variant-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var pos = this.dataset.optionPosition;
        this.closest('.variant-options').querySelectorAll('.variant-btn').forEach(function(b) { b.classList.remove('selected'); });
        this.classList.add('selected');
        updateSelectedVariant();
      });
    });

    function updateSelectedVariant() {
      var selected = [];
      document.querySelectorAll('.variant-group').forEach(function(g) {
        var active = g.querySelector('.variant-btn.selected');
        if (active) selected.push(active.dataset.value);
      });
      var match = productData.find(function(v) {
        return v.options.every(function(o, i) { return o === selected[i]; });
      });
      if (!match) return;
      var priceEl = document.getElementById('ProductPrice');
      var addBtn = document.getElementById('AddToCart');
      if (priceEl) priceEl.textContent = formatMoney(match.price);
      var variantInput = document.getElementById('ProductVariantId');
      if (variantInput) variantInput.value = match.id;
      if (addBtn) {
        addBtn.disabled = !match.available;
        addBtn.textContent = match.available ? 'Add to Cart — ' + formatMoney(match.price) : 'Sold Out';
      }
    }

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    // Thumbnail gallery
    document.querySelectorAll('.product-thumb').forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        document.querySelectorAll('.product-thumb').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        var main = document.getElementById('ProductFeaturedImage');
        if (main && this.dataset.src) main.src = this.dataset.src;
      });
    });

    // Quantity selector
    document.querySelectorAll('.qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.getElementById('ProductQuantity');
        var val = parseInt(input.value) || 1;
        if (this.dataset.action === 'increase') input.value = val + 1;
        else if (val > 1) input.value = val - 1;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share links",
      "default": false
    }
  ]
}
{% endschema %}
