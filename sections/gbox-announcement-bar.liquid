{%- if section.settings.show_bar -%}
<style>
  .gbox-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
    text-align: center;
    padding: 9px 16px;
    font-weight: 500;
    letter-spacing: .01em;
    line-height: 1.4;
  }
  .gbox-announcement-bar__inner {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 6px;
  }
  .gbox-announcement-bar__sep {
    opacity: .6;
  }
  .gbox-announcement-bar__link {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .gbox-announcement-bar__link:hover {
    opacity: .8;
  }
</style>

<div class="gbox-announcement-bar" role="region" aria-label="Announcement">
  <div class="gbox-announcement-bar__inner">
    {%- if section.settings.text != blank -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
    {%- if section.settings.text2 != blank -%}
      <span class="gbox-announcement-bar__sep">&middot;</span>
      <span>{{ section.settings.text2 }}</span>
    {%- endif -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
      <span class="gbox-announcement-bar__sep">&middot;</span>
      <a href="{{ section.settings.cta_url }}" class="gbox-announcement-bar__link">
        {{ section.settings.cta_text }} &rarr;
      </a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "G-BOX Announcement Bar",
  "class": "gbox-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message 1",
      "default": "🚀 New: Chamoy Frettles are here!"
    },
    {
      "type": "text",
      "id": "text2",
      "label": "Message 2",
      "default": "Free shipping on orders over $40"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2a7c2a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "G-BOX Announcement Bar"
    }
  ]
}
{% endschema %}
