<div class="marquee-section" aria-hidden="true">
  <div class="marquee-track" style="animation-duration: {{ section.settings.speed }}s">
    {%- for i in (1..8) -%}
      <span class="marquee-item">
        {{ section.settings.text_1 }}
        <span class="sep">✦</span>
        {{ section.settings.text_2 }}
        <span class="sep">✦</span>
        {{ section.settings.text_3 }}
        <span class="sep">✦</span>
        {{ section.settings.text_4 }}
        <span class="sep">✦</span>
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Ticker",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Item 1",
      "default": "Free Shipping Over $75"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Item 2",
      "default": "Easy 30-Day Returns"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Item 3",
      "default": "Trending on TikTok"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Item 4",
      "default": "New Drops Weekly"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "info": "Lower = faster, higher = slower",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker"
    }
  ]
}
{% endschema %}
