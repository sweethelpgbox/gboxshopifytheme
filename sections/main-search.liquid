<section class="section main-search" id="main-search-{{ section.id }}">
  <div class="container">

    <header class="page-header">
      <h1 class="page-title">Search</h1>
    </header>

    <!-- Search form -->
    <form action="/search" method="get" class="search-form" role="search">
      <input type="hidden" name="type" value="{{ section.settings.search_type }}">
      <div class="search-input-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          class="search-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search products, articles..."
          aria-label="Search"
          autocomplete="off"
        >
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="search-no-results">
          <p>No results for <strong>"{{ search.terms | escape }}"</strong>.</p>
          <p class="search-suggestions-label">Try:</p>
          <ul class="search-suggestions">
            <li>Checking your spelling</li>
            <li>Using fewer or broader keywords</li>
            <li><a href="/collections/all">Browsing all products</a></li>
          </ul>
        </div>
      {%- else -%}
        <p class="search-results-count">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for
          <strong>"{{ search.terms | escape }}"</strong>
        </p>

        <div class="search-results">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- assign has_compare = item.compare_at_price > item.price -%}
              <article class="product-card">
                <a href="{{ item.url }}" class="product-card-media">
                  {%- if item.featured_media -%}
                    {{ item.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', alt: item.featured_media.alt | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="product-card-body">
                  <h3 class="product-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <div class="product-card-price">
                    <span class="price-current">{{ item.price | money }}</span>
                    {%- if has_compare -%}<span class="price-compare">{{ item.compare_at_price | money }}</span>{%- endif -%}
                  </div>
                </div>
              </article>

            {%- elsif item.object_type == 'article' -%}
              <article class="article-card">
                {%- if item.image -%}
                  <a href="{{ item.url }}" class="article-card-media">
                    {{ item.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}
                  </a>
                {%- endif -%}
                <div class="article-card-body">
                  <p class="article-tag">{{ item.object_type | capitalize }}</p>
                  <h3 class="article-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  {%- if item.excerpt != blank -%}
                    <p class="article-card-excerpt">{{ item.excerpt | strip_html | truncate: 120 }}</p>
                  {%- endif -%}
                  <a href="{{ item.url }}" class="article-card-read-more">Read more →</a>
                </div>
              </article>

            {%- else -%}
              <div class="search-result-page">
                <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                {%- if item.content != blank -%}
                  <p>{{ item.content | strip_html | truncate: 160 }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn-outline">← Previous</a>{%- endif -%}
            <span class="pagination-count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn-outline">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "search_type",
      "label": "Search type",
      "options": [
        { "value": "product,article,page", "label": "Products, articles & pages" },
        { "value": "product", "label": "Products only" },
        { "value": "product,article", "label": "Products & articles" }
      ],
      "default": "product,article,page"
    }
  ]
}
{% endschema %}
