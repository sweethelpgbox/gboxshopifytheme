{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}

<section class="section main-collection" id="main-collection-{{ section.id }}">
  <div class="container">

    <!-- Collection header -->
    {%- if section.settings.show_header -%}
      <header class="collection-header">
        {%- if collection.image and section.settings.show_image -%}
          <div class="collection-banner">
            {{
              collection.image
              | image_url: width: 1400
              | image_tag: loading: 'eager', alt: collection.title | escape
            }}
            <div class="collection-banner-overlay">
              <h1 class="collection-title">{{ collection.title }}</h1>
              {%- if collection.description != blank -%}
                <p class="collection-description">{{ collection.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <h1 class="collection-title">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}
            <p class="collection-description">{{ collection.description }}</p>
          {%- endif -%}
        {%- endif -%}
      </header>
    {%- endif -%}

    <!-- Toolbar: count + sort -->
    <div class="collection-toolbar">
      <p class="collection-count">
        {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
      </p>
      {%- if section.settings.show_sort -%}
        <div class="collection-sort">
          <label for="SortBy">Sort by</label>
          <select id="SortBy" name="sort_by" onchange="window.location.search='?sort_by='+this.value">
            {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending,created-ascending' | split: ',' -%}
            {%- assign sort_labels  = 'Featured,Best selling,A–Z,Z–A,Price: low to high,Price: high to low,Date: new to old,Date: old to new' | split: ',' -%}
            {%- for option in sort_options -%}
              <option value="{{ option }}"{% if sort_by == option %} selected{% endif %}>
                {{ sort_labels[forloop.index0] }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    <!-- Product grid -->
    <div class="product-grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_per_page -%}
          {%- assign has_compare = product.compare_at_price > product.price -%}
          {%- if has_compare -%}
            {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          {%- endif -%}

          <article class="product-card" data-variant-id="{{ product.first_available_variant.id }}">
            <a href="{{ product.url }}" class="product-card-media">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: product.featured_media.alt | escape
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if product.available == false -%}
                <span class="product-card-badge" style="background:var(--color-text-muted)">Sold Out</span>
              {%- elsif has_compare -%}
                <span class="product-card-badge">-{{ savings }}%</span>
              {%- elsif product.tags contains 'new' -%}
                <span class="product-card-badge" style="background:var(--color-accent-2)">New</span>
              {%- endif -%}

              <button class="product-card-quick-add" aria-label="Quick add {{ product.title | escape }}">Quick Add</button>
            </a>

            <div class="product-card-body">
              {%- if product.vendor != blank -%}
                <p class="product-card-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="product-card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="product-card-price">
                <span class="price-current">{{ product.price | money }}</span>
                {%- if has_compare -%}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ savings }}%</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <div class="collection-empty">
          <p>No products found in this collection.</p>
          <a href="/collections/all" class="btn btn-primary">Browse all products</a>
        </div>
      {%- endif -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn-outline">← Previous</a>
        {%- endif -%}
        <span class="pagination-count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn-outline">Next →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image as banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}
