<section class="cta-band" id="newsletter-{{ section.id }}">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <p class="cta-band-sub">{{ section.settings.subheading }}</p>
    <form class="newsletter-form" action="{{ routes.root_url }}" method="post" id="ContactFooter">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="newsletter-email" class="visually-hidden">Email address</label>
      <input
        class="newsletter-input"
        type="email"
        id="newsletter-email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder }}"
        autocomplete="email"
        required
      >
      <button type="submit" class="btn btn-primary">{{ section.settings.button_label }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter / CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Early Access to New Drops"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join 50,000+ subscribers and be first to know about sales and new arrivals."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter / CTA"
    }
  ]
}
{% endschema %}
