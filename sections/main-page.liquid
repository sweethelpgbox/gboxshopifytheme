<section class="section main-page" id="main-page-{{ section.id }}">
  <div class="container">
    {%- if section.settings.show_title -%}
      <header class="page-header">
        <h1 class="page-title">{{ page.title }}</h1>
      </header>
    {%- endif -%}
    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow (640px)" },
        { "value": "medium", "label": "Medium (800px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "medium"
    }
  ]
}
{% endschema %}
