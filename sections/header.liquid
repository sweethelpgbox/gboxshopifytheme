<header class="site-header" role="banner">
  <div class="container nav-inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 240
          | image_tag: loading: 'eager', class: 'nav-logo-image', alt: shop.name
        }}
      {%- else -%}
        {{ shop.name | split: '' | first }}
        <span class="logo-dot">BOX</span>
      {%- endif -%}
    </a>

    <!-- Nav links -->
    <nav class="nav-links" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a
          href="{{ link.url }}"
          class="{% if link.active %}active{% endif %}"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <!-- Actions -->
    <div class="nav-actions">

      <!-- Search -->
      <a href="{{ routes.search_url }}" class="nav-icon-btn" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </a>

      <!-- Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="nav-icon-btn" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="nav-icon-btn" aria-label="Cart ({{ cart.item_count }} items)">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" x2="21" y1="6" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

    </div><!-- /.nav-actions -->

  </div><!-- /.nav-inner -->
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
