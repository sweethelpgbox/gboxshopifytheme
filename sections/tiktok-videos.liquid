<!-- =====================================================
     TikTok Videos Section
     ===================================================== -->
<section class="tiktok-section" id="tiktok-{{ section.id }}">
  <div class="container">

    <header class="tiktok-header">
      <div>
        <!-- TikTok wordmark badge -->
        <div class="tiktok-logo-badge">
          <!-- TikTok SVG icon with dual-colour effect -->
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32">
            <!-- cyan shadow -->
            <path d="M20.5 2h-4.1v19.7a4.6 4.6 0 0 1-4.6 4.5 4.6 4.6 0 0 1-4.6-4.5 4.6 4.6 0 0 1 4.6-4.5c.45 0 .88.07 1.3.18V13.2a8.8 8.8 0 0 0-1.3-.1 8.7 8.7 0 0 0-8.7 8.6 8.7 8.7 0 0 0 8.7 8.7 8.7 8.7 0 0 0 8.7-8.7V12.3a12.4 12.4 0 0 0 7.3 2.3v-4.1a8.3 8.3 0 0 1-7.3-8.5z" fill="#00c2cb" transform="translate(-1, -1)"/>
            <!-- red shadow -->
            <path d="M20.5 2h-4.1v19.7a4.6 4.6 0 0 1-4.6 4.5 4.6 4.6 0 0 1-4.6-4.5 4.6 4.6 0 0 1 4.6-4.5c.45 0 .88.07 1.3.18V13.2a8.8 8.8 0 0 0-1.3-.1 8.7 8.7 0 0 0-8.7 8.6 8.7 8.7 0 0 0 8.7 8.7 8.7 8.7 0 0 0 8.7-8.7V12.3a12.4 12.4 0 0 0 7.3 2.3v-4.1a8.3 8.3 0 0 1-7.3-8.5z" fill="#ff2d55" transform="translate(1, 1)"/>
            <!-- white base -->
            <path d="M20.5 2h-4.1v19.7a4.6 4.6 0 0 1-4.6 4.5 4.6 4.6 0 0 1-4.6-4.5 4.6 4.6 0 0 1 4.6-4.5c.45 0 .88.07 1.3.18V13.2a8.8 8.8 0 0 0-1.3-.1 8.7 8.7 0 0 0-8.7 8.6 8.7 8.7 0 0 0 8.7 8.7 8.7 8.7 0 0 0 8.7-8.7V12.3a12.4 12.4 0 0 0 7.3 2.3v-4.1a8.3 8.3 0 0 1-7.3-8.5z" fill="#1a1714"/>
          </svg>
          <span>As seen on TikTok</span>
        </div>

        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.tiktok_handle != blank -%}
        <a
          href="https://www.tiktok.com/@{{ section.settings.tiktok_handle }}"
          target="_blank"
          rel="noopener noreferrer"
          class="tiktok-follow-btn"
          aria-label="Follow us on TikTok"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34l.04-8.86a8.34 8.34 0 0 0 4.87 1.56V4.55a4.85 4.85 0 0 1-1.14.14z"/>
          </svg>
          @{{ section.settings.tiktok_handle }}
        </a>
      {%- endif -%}
    </header>

    <!-- Video grid -->
    <div class="tiktok-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'video' -%}
          <div
            class="tiktok-card"
            {{ block.shopify_attributes }}
            {% if block.settings.video_url != blank %}
              data-video-url="{{ block.settings.video_url }}"
              role="button"
              tabindex="0"
              aria-label="Watch TikTok: {{ block.settings.caption | default: 'video' | escape }}"
            {% endif %}
          >

            {%- if block.settings.thumbnail != blank -%}
              {{
                block.settings.thumbnail
                | image_url: width: 400
                | image_tag:
                  class: 'tiktok-card-thumb',
                  loading: 'lazy',
                  alt: block.settings.caption | default: '' | escape
              }}
            {%- else -%}
              <div class="tiktok-card-placeholder">
                <div class="tiktok-play-btn">
                  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
                <span style="font-size:0.75rem;color:var(--color-text-muted)">TikTok Video</span>
              </div>
            {%- endif -%}

            <!-- Play overlay (shows on hover when thumbnail present) -->
            {%- if block.settings.thumbnail != blank -%}
              <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1;pointer-events:none;">
                <div class="tiktok-play-btn">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            {%- endif -%}

            <!-- Hover overlay with caption & stats -->
            <div class="tiktok-card-overlay">
              <div class="tiktok-card-meta">
                {%- if block.settings.caption != blank -%}
                  <p class="tiktok-card-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
                <div class="tiktok-card-stats">
                  {%- if block.settings.likes != blank -%}
                    <span class="tiktok-card-stat">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                      {{ block.settings.likes }}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.views != blank -%}
                    <span class="tiktok-card-stat">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      {{ block.settings.views }}
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- Linked product badge -->
            {%- if block.settings.linked_product != blank -%}
              {%- assign linked = all_products[block.settings.linked_product] -%}
              {%- if linked != blank -%}
                <a
                  href="{{ linked.url }}"
                  class="product-card-badge"
                  style="position:absolute;bottom:12px;left:12px;z-index:10;top:auto;"
                  onclick="event.stopPropagation()"
                >
                  Shop ↗
                </a>
              {%- endif -%}
            {%- endif -%}

          </div><!-- /.tiktok-card -->
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <!-- Placeholder cards for the editor -->
        {%- for i in (1..6) -%}
          <div class="tiktok-card">
            <div class="tiktok-card-placeholder">
              <div class="tiktok-play-btn">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <span style="font-size:0.75rem;color:var(--color-text-light);">Add a video</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div><!-- /.tiktok-grid -->

    <!-- CTA below grid -->
    {%- if section.settings.cta_label != blank and section.settings.tiktok_handle != blank -%}
      <div style="text-align:center;margin-top:36px;">
        <a
          href="https://www.tiktok.com/@{{ section.settings.tiktok_handle }}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          {{ section.settings.cta_label }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "TikTok Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Watch Us on TikTok"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Real customers, real reviews — follow along for exclusive drops and behind-the-scenes content."
    },
    {
      "type": "text",
      "id": "tiktok_handle",
      "label": "TikTok handle (without @)",
      "info": "e.g. yourbrand",
      "default": "yourbrand"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "View more CTA label",
      "default": "See more on TikTok"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "TikTok Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Video thumbnail image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "TikTok video URL"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / description",
          "default": "Check out our latest drop! 🔥 #gbox #fyp"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Like count (display only)",
          "default": "12.4K"
        },
        {
          "type": "text",
          "id": "views",
          "label": "View count (display only)",
          "default": "248K"
        },
        {
          "type": "product",
          "id": "linked_product",
          "label": "Linked product (shows Shop badge)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TikTok Videos",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
